# Copy this file to scripts/env.local.sh (git-ignored) on a machine whose layout
# differs from the default in env.sh. It is sourced BEFORE the defaults, so a
# plain export here wins; use `unset` to fall back to auto-detection.
#
# The defaults in env.sh already match the verified setup on the original build
# host (everything on D:). You only need this file for a different root, a Linux
# runner, or a second JDK.

# Where the OpenHarmony SDK + hvigor + JDK live on this machine.
export OHOS_TOOLS_ROOT="/opt/ohos-tools"

# $OHOS_TOOLS_ROOT/sdk must contain openharmony/ (the components) and a
# directory named after the API level, which hvigor uses to find components:
#   ln -s $OHOS_TOOLS_ROOT/sdk/openharmony $OHOS_TOOLS_ROOT/sdk/10
export OHOS_BASE_SDK_HOME="$OHOS_TOOLS_ROOT/sdk"
export OHOS_SDK_TOOLCHAINS="$OHOS_BASE_SDK_HOME/openharmony/toolchains"

export HVIGOR_CLI="$OHOS_TOOLS_ROOT/hvigor-3.2.4/node_modules/@ohos/hvigor/bin/hvigor-simple.js"
export NODE_PATH="$OHOS_TOOLS_ROOT/hvigor-3.2.4/node_modules"

# node and java. hvigor spawns bare `java` during PackageHap, so also make sure
# a JDK bin dir is on PATH (env.sh does that from JAVA_HOME automatically).
export OHOS_NODE="/usr/bin/node"
export JAVA_HOME="/usr/lib/jvm/java-17-openjdk-amd64"

# Which hdc talks to the board. 1.3.0a ships with the API 10 SDK, 3.2.0f with
# DevEco 26; if the board never shows up in `list targets`, try the other one.
# export HDC="$OHOS_TOOLS_ROOT/sdk/openharmony/toolchains/hdc"

# Point at an IDE-generated signing set instead of the locally generated one.
# export OHOS_KEYSTORE="$HOME/.ohos/config/default_homekiosk-xxxx.p12"
# export OHOS_APP_CERT="$HOME/.ohos/config/default_homekiosk-xxxx.cer"
# export OHOS_PROFILE="$HOME/.ohos/config/default_homekiosk-xxxx.p7b"
# export OHOS_KEY_ALIAS=digitalKey
